<mxfile host="app.diagrams.net" agent="Codex">
  <diagram id="readme-flow" name="README horizontal">
    <mxGraphModel dx="1440" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="700" math="0" shadow="0" background="#0B1020">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Keep the native pipeline. Move the LLM out of the data loop." style="text;html=1;strokeColor=none;fillColor=none;fontColor=#F8FAFC;fontSize=28;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="35" width="1000" height="48" as="geometry"/></mxCell>
        <mxCell id="pipeline" value="&lt;b&gt;YOUR NATIVE PIPELINE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;plan = engine.read(data)&lt;br&gt;&amp;nbsp;&amp;nbsp;.sem_filter(&amp;quot;positive&amp;quot;)&lt;br&gt;&amp;nbsp;&amp;nbsp;.sem_map(&amp;quot;extract age&amp;quot;)&lt;br&gt;&amp;nbsp;&amp;nbsp;.sem_join(&amp;quot;same entity&amp;quot;)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#C4B5FD&quot;&gt;sembaker.optimize(plan)&lt;/font&gt;&lt;br&gt;&lt;br&gt;plan.run()&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#94A3B8&quot;&gt;One added line. Same engine API.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#121A2E;strokeColor=#334155;fontColor=#E2E8F0;fontSize=13;align=left;spacing=20;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="300" height="350" as="geometry"/></mxCell>
        <mxCell id="router" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;SemBaker&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#F5D0FE&quot;&gt;per-operator optimizer&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FILTER&amp;nbsp;&amp;nbsp;&amp;nbsp; MAP&amp;nbsp;&amp;nbsp;&amp;nbsp; JOIN&lt;/b&gt;&lt;br&gt;&lt;br&gt;Will compilation amortize?&lt;br&gt;&lt;font color=&quot;#94A3B8&quot;&gt;cost x cardinality&lt;/font&gt;&lt;br&gt;&lt;br&gt;Can code preserve semantics?&lt;br&gt;&lt;font color=&quot;#94A3B8&quot;&gt;codifiability gate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#25194A;gradientColor=#7C3AED;gradientDirection=south;strokeColor=#A78BFA;strokeWidth=2;fontColor=#F8FAFC;fontSize=14;align=left;spacing=24;arcSize=8;" vertex="1" parent="1"><mxGeometry x="450" y="120" width="330" height="350" as="geometry"/></mxCell>
        <mxCell id="compile" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Compile once&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp; &lt;b&gt;1 LLM CALL&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;quot;positive&amp;quot;&amp;nbsp; -&amp;gt; &amp;nbsp;compiled_filter(row)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;N local calls&lt;/b&gt;&amp;nbsp;&amp;nbsp; microseconds / row | 0 tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10231F;strokeColor=#10B981;strokeWidth=2;fontColor=#F8FAFC;fontSize=14;align=left;spacing=20;arcSize=8;" vertex="1" parent="1"><mxGeometry x="875" y="120" width="350" height="220" as="geometry"/></mxCell>
        <mxCell id="native" value="&lt;font style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Keep the native operator&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Non-codifiable or too small to amortize&lt;br&gt;&lt;br&gt;&lt;b&gt;N engine-managed LLM calls&lt;/b&gt; | safe fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A2115;strokeColor=#B7791F;strokeWidth=2;fontColor=#F8FAFC;fontSize=13;align=left;spacing=20;arcSize=8;" vertex="1" parent="1"><mxGeometry x="875" y="365" width="350" height="105" as="geometry"/></mxCell>
        <mxCell id="result" value="&lt;font style=&quot;font-size:28px&quot;&gt;[ ]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;RESULT&lt;/b&gt;&lt;br&gt;OK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4ED8;gradientColor=#7C3AED;gradientDirection=south;strokeColor=#A78BFA;fontColor=#FFFFFF;fontSize=14;align=center;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="235" width="100" height="170" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#A78BFA;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pipeline" target="router"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="BAKE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#34D399;strokeWidth=3;endArrow=block;endFill=1;fontColor=#A7F3D0;fontStyle=1;" edge="1" parent="1" source="router" target="compile"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="NATIVE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F59E0B;strokeWidth=2;endArrow=block;endFill=1;fontColor=#FDE68A;fontStyle=1;" edge="1" parent="1" source="router" target="native"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#34D399;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="compile" target="result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F59E0B;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="native" target="result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="footer" value="&lt;b&gt;PLUGS INTO THE ENGINE YOU ALREADY USE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Palimpzest&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; LOTUS&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Nirvana&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; DocETL&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#94A3B8&quot;&gt;Unsupported operators stay native. The original engine still owns execution.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10182A;strokeColor=#263247;fontColor=#E2E8F0;fontSize=13;align=left;spacing=18;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="555" width="1320" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
